# .env로 복사해서 채운다. .env는 저장소에 올리지 않는다

# 에어코리아 인증키. 공공데이터포털에서 "한국환경공단_에어코리아_대기오염정보" 활용신청 후 받은 일반 인증키(Decoding)
AIRKOREA_API_KEY=

# POST /api/ingest/estimates 인증 토큰. A가 정해 팀장에게 알려 주기
INGEST_TOKEN=

DATABASE_URL=postgresql://localhost:5432/pm_map

# 직접 해보기(POST /api/infer) 명령. 팀장이 VM 경로를 채움. 로컬 개발: INFER_CMD=python tests/fake_infer.py (server/에서 실행할 때)
INFER_CMD=

# 장소 검색(GET /api/search)에 쓰는 카카오 REST API 키. 팀장이 서버에 넣음. 비어 있으면 검색이 503
KAKAO_REST_KEY=
